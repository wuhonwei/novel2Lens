{
  "_meta": {
    "id": "qwen_image_2_1_t2i_gguf_api_v1",
    "title": "Qwen Image 2.1 GGUF text-to-image (jailbreak workflow)",
    "description": "Port of 越狱工作流 image_qwen_image_2_1_t2i_gguf.json to API format. Uses UnetLoaderGGUF + TextEncodeQwenImage21.",
    "requires_models": true
  },
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "qwen-image-2.1-Q8_0.gguf"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_bf16.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "4": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["2", 0],
      "prompt": "a character portrait",
      "negative_prompt": "",
      "resolution": 1024
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["5", 0]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["3", 0]
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "novel2lens_qwen21_t2i",
      "images": ["7", 0]
    }
  }
}
