{
  "_meta": {
    "id": "ideogram4_t2i_api_v1",
    "title": "Ideogram 4 scene B-roll (API)",
    "description": "Scene establishing shots via Ideogram 4 asymmetric CFG (no PhotoMaker). Flattened from official UI template.",
    "requires_models": true,
    "compatible_manifest_ids": [
      "ideogram4_fp8",
      "ideogram4_unconditional_fp8",
      "qwen3vl_8b_ideogram",
      "flux2_vae"
    ]
  },
  "23": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ideogram4_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "154": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ideogram4_unconditional_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "14": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_fp8_scaled.safetensors",
      "type": "ideogram4",
      "device": "default"
    }
  },
  "9": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "24": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "placeholder positive",
      "clip": ["14", 0]
    }
  },
  "10": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["24", 0]
    }
  },
  "157": {
    "class_type": "CFGOverride",
    "inputs": {
      "model": ["23", 0],
      "cfg": 3.0,
      "start_percent": 0.7,
      "end_percent": 1.0
    }
  },
  "155": {
    "class_type": "DualModelGuider",
    "inputs": {
      "model": ["157", 0],
      "positive": ["24", 0],
      "cfg": 7.0,
      "model_negative": ["154", 0],
      "negative": ["10", 0]
    }
  },
  "11": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1344,
      "height": 768,
      "batch_size": 1
    }
  },
  "17": {
    "class_type": "Ideogram4Scheduler",
    "inputs": {
      "steps": 20,
      "width": 1344,
      "height": 768,
      "mu": 0.5,
      "std": 1.75
    }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "18": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["18", 0],
      "guider": ["155", 0],
      "sampler": ["16", 0],
      "sigmas": ["17", 0],
      "latent_image": ["11", 0]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["9", 0]
    }
  },
  "158": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "nvs_ideogram4",
      "images": ["13", 0]
    }
  }
}
